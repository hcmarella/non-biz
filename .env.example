# Base URL of the BFF (this repo's bff/server.mjs) — the browser only ever
# talks to the BFF, never to forge-api-gateway directly (ARCHITECTURE.md §1-2).
# Local dev (npm run bff): http://localhost:4000
# Docker-compose network: http://bff:4000 (service name — see docker-compose.yml
# and the note in ARCHITECTURE.md §6.4 about why localhost breaks in this setup)
VITE_API_BASE_URL=http://localhost:4000

# Read by bff/server.mjs — where the BFF forwards to. Point this at the real
# forge-api-gateway when it exists; until then it targets the local mock.
# GATEWAY_BASE_URL=http://localhost:8787
